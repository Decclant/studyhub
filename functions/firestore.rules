rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

match /users/{userId} {
allow read, update: if request.auth != null && request.auth.uid == userId;
allow create: if request.auth != null;
}

match /users/{userId}/flashcards/{cardId} {
allow read, write: if request.auth != null && request.auth.uid == userId;
}

match /artifacts/{appId}/public/data/flashcards/{cardId} {
allow read: if request.auth != null;

allow update: if request.auth != null && request.auth.uid == resource.data.authorId &&
request.resource.data.authorId == resource.data.authorId;

allow create, delete: if request.auth != null && request.auth.uid == request.resource.data.authorId;
}

match /adminLogs/{logId} {
allow read, write: if request.auth.uid == 'admin-123';
}

match /{document=**} {
allow read, write: if false;
}

}
}